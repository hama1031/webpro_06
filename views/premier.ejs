<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <title>プレミアリーグのクラブ</title>
</head>
<body>
  <h2>プレミアリーグのクラブ一覧</h2>
  <table border="1">
    <tr><th>ID</th><th>クラブ名</th><th>本拠地</th><th>スタジアム</th></tr>
    <% for( let row of data ) { %>
      <tr>
        <td><%= row.id %></td>
        <td><%= row.name %></td>
        <td><%= row.city %></td>
        <td><%= row.stadium %></td>
      </tr>
    <% } %>
  </table>
</body>
</html>